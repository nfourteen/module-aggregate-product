<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <attribute name="class" value="page-product-aggregate"/>
        <referenceContainer name="product.info.type">
            <block class="Nfourteen\AggregateProduct\Block\Product\View\Type\Aggregate" name="product.info.aggregate" as="product_type_data" template="Magento_Catalog::product/view/type/default.phtml"/>
        </referenceContainer>
        <referenceBlock name="product.info.main">
            <block class="Nfourteen\AggregateProduct\Block\Product\View\Type\Aggregate" name="product.info.aggregate.configuration" template="Nfourteen_AggregateProduct::breeze/product/view/aggregate_summary.phtml">
                <arguments>
                    <argument name="linked_product_view_model" xsi:type="object">Nfourteen\AggregateProduct\ViewModel\LinkedProducts</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
